{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsip.org/schema/1.0/envelope.schema.json",
  "title": "DSIP-JOSE signed envelope",
  "description": "JWS envelope (spec 11.2). The payload member is the base64url-encoded DSIP JSON payload validated by the per-message schemas.",
  "type": "object",
  "properties": {
    "protected": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "payload": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  },
  "required": [
    "protected",
    "payload",
    "signature"
  ],
  "additionalProperties": false
}
