{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsip.org/schema/1.0/binding/webrtc/info-data.schema.json",
  "title": "transport:webrtc info.data",
  "description": "WebRTC Media Binding 1.0, Appendix A: trickle ICE candidates carried in signed info envelopes. sdp_mid is required (BUNDLE still needs the mid to disambiguate); end_of_candidates is sent true exactly once per local description.",
  "type": "object",
  "properties": {
    "candidates": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "candidate": {
            "type": "string",
            "pattern": "^candidate:",
            "maxLength": 512
          },
          "sdp_mid": {
            "type": "string",
            "maxLength": 64
          },
          "sdp_m_line_index": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "candidate",
          "sdp_mid"
        ],
        "additionalProperties": false
      }
    },
    "end_of_candidates": {
      "type": "boolean"
    }
  },
  "required": [
    "candidates",
    "end_of_candidates"
  ],
  "additionalProperties": false
}
