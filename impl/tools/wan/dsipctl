#!/usr/bin/env bash
# Validation helpers for the DSIP WAN testbed. Run on any node.
#   dsipctl stats [host]        DHT counters from the control port (local by default)
#   dsipctl addrs               addresses the local DHT node is advertising
#   dsipctl get <did>           raw DHT GET for a DID (every copy, with the node's verdict on each)
#   dsipctl resolve <did>       what an endpoint sees (dsip resolve via this node's bootstrap)
#   dsipctl peers               routing-table size over time (5 samples)
#   dsipctl relay-tail          follow the relay's journal (bound device / invite → leg / attempt outcome)
#   dsipctl relay-status [-v]   the relay's status page: bound devices, sessions, queues, refusals (-v: DIDs, sessions)
#   dsipctl mailbox-status [-v] the mailbox's: enrolment, storage against quota, hubs, refusals (-v: per owner and hub)
#   dsipctl metrics             both services' Prometheus metrics
#   dsipctl mailbox-tail        follow the mailbox + hub journal
#   dsipctl turn-tail           follow coturn's log (allocations show a TURN relay in use)
#   dsipctl turn-cred [ttl]     mint TURN credentials from /var/lib/dsip/turn.secret (what the relay's /turn does for browsers)
#   dsipctl cap-sig             tcpdump: libp2p + wss control traffic (DHT, relay, mailbox)
#   dsipctl cap-rtp             tcpdump: UDP (ICE/STUN/TURN/SRTP) — run on an endpoint
#   dsipctl ports               what is listening
#   dsipctl drift               clock offset (replay window sanity)
#   dsipctl commit              the commit(s) this host's binaries were built from, the packages' versions, and each binary's sha256 (a
#                               component deployed by hand belongs in /var/lib/dsip/commit with its commit)
set -euo pipefail
CTRL=${CTRL:-127.0.0.1:4101}
# GETs wait out the query timeout (10 s) when a peer near the key is unreachable: give them 30 s.
ctl(){ printf '%s\n' "$1" | nc -q1 -w${2:-3} ${CTRL/:/ } ; }
case "${1:-}" in
  stats)   ctl '{"op":"stats"}' | jq . ;;
  addrs)   ctl '{"op":"addrs"}' | jq . ;;
  get)     ctl "{\"op\":\"get\",\"did\":\"$2\"}" 30 | jq . ;;
  resolve) dsip resolve "$2" --dht "$(cat /var/lib/dsip/bootstrap 2>/dev/null || cat /var/lib/dsip/my-multiaddr)" ;;
  peers)   for i in 1 2 3 4 5; do ctl '{"op":"stats"}' | jq -c '{t:now|floor,routing_peers:.stats.routing_peers,stored:.stats.stored}'; sleep 2; done ;;
  relay-tail)   journalctl -fu dsip-relay -o cat ;;
  # the services' status ports (loopback only), as packaged
  relay-status)   curl -sf "http://127.0.0.1:9101/status$([ "${2:-}" = -v ] && echo '?detail=1')" | jq . ;;
  mailbox-status) curl -sf "http://127.0.0.1:9102/status$([ "${2:-}" = -v ] && echo '?detail=1')" | jq . ;;
  metrics)        curl -sf http://127.0.0.1:9101/metrics; curl -sf http://127.0.0.1:9102/metrics ;;
  mailbox-tail) journalctl -fu dsip-mailbox -o cat ;;
  turn-tail)    tail -f /var/log/turnserver/turn.log ;;
  turn-cred)    # TURN REST API credentials from the shared secret, valid ${2:-3600} s: for dsip call/answer --turn-user/--turn-pass
                S=$(cat /var/lib/dsip/turn.secret); U="$(( $(date +%s) + ${2:-3600} )):dsip"
                echo "--turn-user $U --turn-pass $(printf '%s' "$U" | openssl dgst -sha1 -hmac "$S" -binary | base64)" ;;
  cap-sig) tcpdump -ni any -l 'tcp port 4001 or tcp port 8443 or tcp port 9443' ;;
  cap-rtp) tcpdump -ni any -l 'udp and not port 53 and not port 123' ;;
  ports)   ss -tulpn | grep -E 'dsip|turn|4001|8443|9443|3478' ;;
  drift)   chronyc tracking | grep -E 'System time|Last offset' ;;
  commit)  cat /var/lib/dsip/commit
           dpkg-query -W -f='  ${Package} ${Version}\n' dsip-relay dsip-mailbox dsip-node 2>/dev/null || true
           for b in /usr/local/bin/dsip /usr/local/bin/dsip-msg /usr/local/bin/dsip-dht-node /usr/local/bin/dsip-node \
                    /usr/bin/dsip-relay /usr/bin/dsip-mailbox /usr/bin/dsip-node; do
             [ -f $b ] && echo "  $(sha256sum $b | cut -c1-12)  $(date -r $b '+%F %H:%M')  $b"
           done; true ;;
  *) sed -n 2,20p "$0" ;;
esac
