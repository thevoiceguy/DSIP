{
  "vector": "gateway/trace-inbound-answered",
  "format": 1,
  "kind": "gateway",
  "description": "PSTN→DSIP: INVITE with verified attestation → DSIP invite with the tel claim; ringing → 180; user answer → 200 + bridge; BYE from PSTN.",
  "spec_ref": [
    "§18.1",
    "§14.1",
    "§15.5"
  ],
  "context": {
    "direction": "inbound"
  },
  "input": {
    "check": "trace",
    "steps": [
      {
        "event": {
          "sip": {
            "request": "INVITE",
            "from_tn": "+15551234567",
            "identity": {
              "attest": "A",
              "verified": true,
              "orig_tn": "+15551234567"
            }
          }
        }
      },
      {
        "event": {
          "dsip": {
            "type": "progress",
            "status": "ringing"
          }
        }
      },
      {
        "event": {
          "dsip": {
            "type": "answer",
            "answered_by": "user"
          }
        }
      },
      {
        "event": {
          "sip": {
            "request": "ACK"
          }
        }
      },
      {
        "event": {
          "sip": {
            "request": "BYE"
          }
        }
      }
    ]
  },
  "expect": {
    "steps": [
      {
        "emit": [
          {
            "dsip": {
              "local": "place_call",
              "claims": [
                {
                  "type": "tel",
                  "number": "+15551234567",
                  "attestation": "A",
                  "verified": true,
                  "verifier": "did:web:gw.example"
                }
              ],
              "trust_basis": "Gateway attested by gw.example · STIR attestation A (verified)"
            }
          },
          {
            "sip": {
              "response": 100
            }
          }
        ],
        "state": {
          "dsip": "offered",
          "sip": "early"
        }
      },
      {
        "emit": [
          {
            "sip": {
              "response": 180
            }
          }
        ],
        "state": {
          "dsip": "alerting",
          "sip": "early"
        }
      },
      {
        "emit": [
          {
            "sip": {
              "response": 200,
              "direction": "sendrecv"
            }
          },
          {
            "media": "bridge"
          }
        ],
        "state": {
          "dsip": "active",
          "sip": "confirmed"
        }
      },
      {
        "emit": [],
        "state": {
          "dsip": "active",
          "sip": "confirmed"
        }
      },
      {
        "emit": [
          {
            "sip": {
              "response": 200
            }
          },
          {
            "dsip": {
              "local": "hangup",
              "reason": "user.hangup"
            }
          },
          {
            "media": "release"
          }
        ],
        "state": {
          "dsip": "ended",
          "sip": "terminated"
        }
      }
    ]
  }
}
