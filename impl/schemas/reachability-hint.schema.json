{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsip.org/schema/impl/reachability-hint.schema.json",
  "title": "DSIP reachability hint (implementation-local, DHT hints tier)",
  "description": "Signed, expiring reachability hint distributed via the DHT hints tier (spec 8.3, 8.5; plan 10). Never authoritative: verified against the subject DID or a delegation before use. This schema is owned by the PoC, not the spec; it is candidate text for a DHT Hints Profile.",
  "type": "object",
  "properties": {
    "dsip": {"type": "object"},
    "type": {"const": "reachability-hint"},
    "id": {"type": "string", "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"},
    "from": {"type": "string", "pattern": "^did:[a-z0-9]+:[A-Za-z0-9.%_:-]+$"},
    "subject": {"type": "string", "pattern": "^did:[a-z0-9]+:[A-Za-z0-9.%_:-]+$"},
    "endpoints": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "uri": {"type": "string", "pattern": "^wss://"},
          "bindings": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9]+/\\d+\\.\\d+$"}}
        },
        "required": ["uri", "bindings"],
        "additionalProperties": true
      }
    },
    "seq": {"type": "integer", "minimum": 0},
    "issued_at": {"type": "integer", "minimum": 0},
    "expires_at": {"type": "integer", "minimum": 0}
  },
  "required": ["dsip", "type", "id", "from", "subject", "endpoints", "seq", "issued_at", "expires_at"],
  "additionalProperties": false
}
